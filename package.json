{
  "name": "little-room",
  "version": "0.1.0",
  "description": "A local-first Pomodoro app with cozy illustrated rooms, animal companions, and focus tracking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAmJennyZhao/PomodoroTimer.git"
  },
  "private": true,
  "engines": {
    "node": "^22 || ^24"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "start": "node scripts/dev.cjs",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "node scripts/check.cjs frontend",
    "test:server": "node scripts/check.cjs server",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "browsers:install": "node node_modules/@playwright/test/cli.js install chromium firefox webkit",
    "build:check": "node scripts/check.cjs build",
    "check": "node scripts/check.cjs core",
    "validate": "node scripts/check.cjs all",
    "qa:release": "node scripts/release-qa.cjs",
    "showcase:capture": "node scripts/showcase-capture.cjs",
    "showcase:render": "node scripts/showcase-render.cjs",
    "audit:publication": "node scripts/audit-publication.cjs",
    "history:lookup": "node scripts/history-lookup.cjs",
    "history:verify": "node scripts/check-history.cjs",
    "audit:dependencies": "node scripts/audit-dependencies.cjs",
    "serve": "node server/index.cjs",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.{js,jsx,ts,tsx}",
      "**/*.{spec,test}.{js,jsx,ts,tsx}"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@babel/plugin-transform-modules-commonjs": "^7.23.3",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "react-scripts": "5.0.1"
  }
}
